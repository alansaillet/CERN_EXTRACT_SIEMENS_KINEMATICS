; ============================================================================
; READ_TRACYL_KINEMATICS.MPF
; Program: Read and report TRACYL (cylinder surface transformation) kinematics
;
; DESCRIPTION:
;   TRACYL (Transformation for CYLindrical surface milling) is a SINUMERIK
;   transformation that "unrolls" the surface of a cylinder so that the
;   part program can describe grooves, slots and contours as if they were
;   cut on a flat Cartesian plane.  The CNC re-maps the programmed Y-motion
;   into rotary (C-axis) motion, keeping the tool tangent to the cylinder
;   surface.
;
;   Conceptually:
;     Programmed Y   → C-axis angle (arc-length on the cylinder)
;     Programmed X   → radial depth (diameter offset)
;     Programmed Z   → axial feed  (along cylinder axis, unchanged)
;
;   The key geometric parameter is the cylinder radius R (or diameter),
;   which controls the Y-to-C scale factor:
;
;        C [rad] = Y_programmed / R_cylinder
;
;   TRACYL requires that the radial feedrate is defined relative to the
;   surface of the cylinder, not to the axis of rotation.
;
;   Key machine-data parameters (channel MD, $MC_xxx), from reference manual
;   840Dsl_md_para_lists_man_1219_en-US:
;   ┌──────────┬──────────────────────────────────┬──────────────────────────┐
;   │ MD number│ Variable name ($MC_)              │ Description              │
;   ├──────────┼──────────────────────────────────┼──────────────────────────┤
;   │ 24100    │ TRAFO_TYPE_1                       │ = 512+ for TRACYL        │
;   │ 24110    │ TRAFO_AXES_IN_1[0..n]              │ Axis mapping (input)     │
;   │ 24120    │ TRAFO_GEOAX_ASSIGN_TAB_1[0..2]     │ Geometry-axis assignment │
;   │ 24800    │ TRACYL_ROT_AX_OFFSET_1             │ Rotary-axis angle offset │
;   │ 24805    │ TRACYL_ROT_AX_FRAME_1              │ Rotary-axis frame flag   │
;   │ 24810    │ TRACYL_ROT_SIGN_IS_PLUS_1          │ Sign of rotary axis      │
;   │ 24820    │ TRACYL_BASE_TOOL_1[0..2]           │ Base-tool offset vector  │
;   └──────────┴──────────────────────────────────┴──────────────────────────┘
;
;   The cylinder radius is NOT stored in machine data; it is supplied by the
;   part program at runtime using the TRACYL(radius) call syntax.
;   Example:
;       TRACYL(25.0)    ; cylinder radius = 25 mm
;
;   G-codes for TRACYL:
;     TRACYL(r)  – activate cylinder surface transformation, r = radius [mm]
;     TRAFOOF    – deactivate transformation
;
;   Runtime variables:
;     $P_TRAFO        – active transformation name
;     $P_TRACYL_CYLR  – current cylinder radius as programmed
;
; PLATFORM:    Siemens SINUMERIK 840D sl / SINUMERIK ONE
; LANGUAGE:    SINUMERIK NC High-Level Language (HLL)
; OUTPUT FILE: /user/sinumerik/hmi/log/tracyl_kinematics.txt
;
; REVISION HISTORY:
;   2024-01-01  Initial version
;   2024-06-01  Corrected all MD numbers from reference manual
; ============================================================================

; --- Working variables -------------------------------------------------------
DEF INT         _fd
DEF INT         _trafoType
DEF REAL        _rotAxOffset
DEF INT         _rotAxFrame
DEF REAL        _cylRadius
DEF STRING[120] _line
DEF INT         _i
DEF REAL        _rx, _ry, _rz

; --- Output file path --------------------------------------------------------
DEF STRING[120] _outFile
_outFile = "/user/sinumerik/hmi/log/tracyl_kinematics.txt"

; ============================================================================
; Main program body
; ============================================================================

_fd = FILEOPEN(_outFile, 0)           ; 0 = write / create-or-truncate
IF _fd < 0
  MSG("ERROR: Cannot create " << _outFile)
  M30
ENDIF

; ---- Header -----------------------------------------------------------------
FILEWRITE(_fd, "============================================================")
FILEWRITE(_fd, "  SINUMERIK KINEMATICS REPORT — TRACYL (CYLINDER SURFACE TRANSFORMATION)")
FILEWRITE(_fd, "  Reference: 840Dsl_md_para_lists_man_1219_en-US")
FILEWRITE(_fd, "============================================================")
FILEWRITE(_fd, "")
FILEWRITE(_fd, "  TRACYL unrolls a cylindrical surface so that the part program")
FILEWRITE(_fd, "  can describe surface contours in flat (Z, Y) coordinates.")
FILEWRITE(_fd, "  The controller maps programmed Y into C-axis rotation.")
FILEWRITE(_fd, "")
_line = "  NC program   : " << $P_PROG
FILEWRITE(_fd, _line)
_line = "  Channel       : " << TOSTRING($AC_CHANNO)
FILEWRITE(_fd, _line)
FILEWRITE(_fd, "")

; ---- Transformation type ---------------------------------------------------
_trafoType = $MC_TRAFO_TYPE_1
FILEWRITE(_fd, "--- TRANSFORMATION TYPE (MD24100  $MC_TRAFO_TYPE_1) ---")
FILEWRITE(_fd, "  TRACYL type codes: 512 to 527 (low 4 bits = sub-variant).")
FILEWRITE(_fd, "  Sub-variant 514 bit 1 selects groove-side offset mode.")
_line = "  TRAFO_TYPE_1 = " << TOSTRING(_trafoType)
FILEWRITE(_fd, _line)
IF (_trafoType >= 512) AND (_trafoType <= 527)
  FILEWRITE(_fd, "  => TRACYL (cylinder surface transformation) is configured.")
ELSE
  _line = "  => WARNING: TRAFO_TYPE_1 is not in the TRACYL range 512-527."
  FILEWRITE(_fd, _line)
  _line = "               Actual type code = " << TOSTRING(_trafoType)
  FILEWRITE(_fd, _line)
ENDIF
FILEWRITE(_fd, "")

; ---- Axis assignment -------------------------------------------------------
FILEWRITE(_fd, "--- AXIS ASSIGNMENT ---")
FILEWRITE(_fd, "  Input geometry axes (MD24110  $MC_TRAFO_AXES_IN_1[]) — 0 = unused:")
FOR _i = 0 TO 2
  _line = "    TRAFO_AXES_IN_1[" << TOSTRING(_i) << "] = " << TOSTRING($MC_TRAFO_AXES_IN_1[_i])
  FILEWRITE(_fd, _line)
ENDFOR
FILEWRITE(_fd, "")
FILEWRITE(_fd, "  Geometry-axis → channel-axis assignment")
FILEWRITE(_fd, "  (MD24120  $MC_TRAFO_GEOAX_ASSIGN_TAB_1[0..2]):")
FOR _i = 0 TO 2
  _line = "    geom axis [" << TOSTRING(_i) << "] mapped to channel axis = " << TOSTRING($MC_TRAFO_GEOAX_ASSIGN_TAB_1[_i])
  FILEWRITE(_fd, _line)
ENDFOR
FILEWRITE(_fd, "")

; ---- Rotary axis offset (MD24800) -----------------------------------------
FILEWRITE(_fd, "--- ROTARY AXIS OFFSET (MD24800  $MC_TRACYL_ROT_AX_OFFSET_1) ---")
FILEWRITE(_fd, "  Angular offset of the rotary axis for TRACYL in degrees,")
FILEWRITE(_fd, "  relative to the neutral position while TRACYL is active.")
_rotAxOffset = $MC_TRACYL_ROT_AX_OFFSET_1
_line = "  TRACYL_ROT_AX_OFFSET_1 = " << TOSTRING(_rotAxOffset) << " [deg]"
FILEWRITE(_fd, _line)
FILEWRITE(_fd, "")

; ---- Rotary axis frame flag (MD24805) -------------------------------------
FILEWRITE(_fd, "--- ROTARY AXIS FRAME FLAG (MD24805  $MC_TRACYL_ROT_AX_FRAME_1) ---")
FILEWRITE(_fd, "  Controls whether the rotary-axis offset is applied via the")
FILEWRITE(_fd, "  transformation frame ($P_TRAFRAME).")
_rotAxFrame = $MC_TRACYL_ROT_AX_FRAME_1
_line = "  TRACYL_ROT_AX_FRAME_1 = " << TOSTRING(_rotAxFrame)
FILEWRITE(_fd, _line)
IF _rotAxFrame == 0
  FILEWRITE(_fd, "    => 0: Axial rotary-axis offset is NOT considered.")
ENDIF
IF _rotAxFrame == 1
  FILEWRITE(_fd, "    => 1: Axial rotary-axis offset IS considered.")
ENDIF
IF _rotAxFrame == 2
  FILEWRITE(_fd, "    => 2: Offset considered until SZS (SZS frames include offset).")
ENDIF
FILEWRITE(_fd, "")

; ---- Sign of rotary axis (MD24810) ----------------------------------------
FILEWRITE(_fd, "--- ROTARY AXIS SIGN (MD24810  $MC_TRACYL_ROT_SIGN_IS_PLUS_1) ---")
FILEWRITE(_fd, "  Indicates the sign with which the rotary axis is taken into account")
FILEWRITE(_fd, "  in the TRACYL transformation.")
FILEWRITE(_fd, "  TRUE  = positive Y-motion causes C rotation in positive direction.")
FILEWRITE(_fd, "  FALSE = C-axis direction is reversed relative to programmed Y.")
IF $MC_TRACYL_ROT_SIGN_IS_PLUS_1 == TRUE
  FILEWRITE(_fd, "  TRACYL_ROT_SIGN_IS_PLUS_1 = TRUE  (standard direction)")
ELSE
  FILEWRITE(_fd, "  TRACYL_ROT_SIGN_IS_PLUS_1 = FALSE (reversed direction)")
ENDIF
FILEWRITE(_fd, "")

; ---- Base tool vector (MD24820) -------------------------------------------
FILEWRITE(_fd, "--- BASE TOOL VECTOR (MD24820  $MC_TRACYL_BASE_TOOL_1) ---")
FILEWRITE(_fd, "  Basic offset of the tool zero for the TRACYL transformation.")
FILEWRITE(_fd, "  Referenced to the geometry axes active when TRACYL is active.")
FILEWRITE(_fd, "  Applied with and without tool-length compensation.")
FILEWRITE(_fd, "  Programmed length corrections are additive to this base tool.")
_rx = $MC_TRACYL_BASE_TOOL_1[0]
_ry = $MC_TRACYL_BASE_TOOL_1[1]
_rz = $MC_TRACYL_BASE_TOOL_1[2]
_line = "  TRACYL_BASE_TOOL_1 = [" << TOSTRING(_rx) << ", " << TOSTRING(_ry) << ", " << TOSTRING(_rz) << "]  [mm]"
FILEWRITE(_fd, _line)
FILEWRITE(_fd, "")

; ---- Cylinder radius (runtime) --------------------------------------------
FILEWRITE(_fd, "--- CYLINDER RADIUS (RUNTIME PARAMETER) ---")
FILEWRITE(_fd, "  The cylinder radius is NOT stored in machine data.")
FILEWRITE(_fd, "  It is specified in the part program with the TRACYL(r) call.")
FILEWRITE(_fd, "  During execution, $P_TRACYL_CYLR holds the active radius.")
_cylRadius = $P_TRACYL_CYLR
_line = "  $P_TRACYL_CYLR (current active radius) = " << TOSTRING(_cylRadius) << " [mm]"
FILEWRITE(_fd, _line)
FILEWRITE(_fd, "")
FILEWRITE(_fd, "  The Y-to-C scale factor is:  C [deg] = (Y [mm] / R [mm]) * (180/pi)")
FILEWRITE(_fd, "  For example, with R = 25 mm:")
FILEWRITE(_fd, "    Y = 10 mm  =>  C = 10/25 * 180/pi ≈ 22.92 deg")
FILEWRITE(_fd, "")

; ---- Runtime status --------------------------------------------------------
FILEWRITE(_fd, "--- RUNTIME TRANSFORMATION STATUS ---")
_line = "  $P_TRAFO (active transformation name) = " << $P_TRAFO
FILEWRITE(_fd, _line)
FILEWRITE(_fd, "")

; ---- G-code reference ------------------------------------------------------
FILEWRITE(_fd, "--- G-CODE USAGE REFERENCE ---")
FILEWRITE(_fd, "  Activate   : TRACYL(radius)  e.g. TRACYL(25.0)  [mm]")
FILEWRITE(_fd, "  Deactivate : TRAFOOF")
FILEWRITE(_fd, "  Work plane : G19 (YZ) is typical for cylindrical surface milling")
FILEWRITE(_fd, "")
FILEWRITE(_fd, "  Example — helical groove on a 50 mm diameter cylinder:")
FILEWRITE(_fd, "    T1 D1              ; select groove mill")
FILEWRITE(_fd, "    G19                ; YZ plane")
FILEWRITE(_fd, "    TRACYL(25.0)       ; cylinder radius = 25 mm")
FILEWRITE(_fd, "    G0 Z0 Y0 X-3       ; approach surface (X = -depth from surface)")
FILEWRITE(_fd, "    G1 Z60 Y40 F200    ; helix on unrolled surface (60 mm axial, 40 mm arc)")
FILEWRITE(_fd, "    G0 X5              ; retract radially")
FILEWRITE(_fd, "    TRAFOOF            ; deactivate")
FILEWRITE(_fd, "")

; ---- Footer -----------------------------------------------------------------
FILEWRITE(_fd, "============================================================")
FILEWRITE(_fd, "  End of TRACYL kinematics report")
FILEWRITE(_fd, "============================================================")

FILECLOSE(_fd)
MSG("TRACYL kinematics report written to: " << _outFile)

M30

; ============================================================================
; End of READ_TRACYL_KINEMATICS.MPF
; ============================================================================


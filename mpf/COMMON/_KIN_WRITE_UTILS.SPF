; ============================================================================
; _KIN_WRITE_UTILS.SPF
; Subprogram: Common file-write utilities for kinematics reporting
;
; DESCRIPTION:
;   Provides helper procedures called by all kinematics-reader programs.
;   Opens / closes the output text file and supplies formatted write
;   routines for booleans, real vectors and section separators.
;
; PLATFORM:    Siemens SINUMERIK 840D sl / SINUMERIK ONE
; LANGUAGE:    SINUMERIK NC High-Level Language (HLL)
; OUTPUT FILE: /user/sinumerik/hmi/log/kinematics_report.txt
;
; USAGE EXAMPLE (in a caller MPF):
;
;   DEF INT    _g_fd                 ; global file descriptor
;   DEF STRING[120] _g_out           ; global output line buffer
;
;   _g_fd = KIN_OPEN_FILE("/user/sinumerik/hmi/log/kinematics_report.txt")
;   IF _g_fd < 0
;     MSG("ERROR: Cannot open kinematics_report.txt")
;     M30
;   ENDIF
;
;   _g_out = "My value = " << TOSTRING(42.0) << " mm"
;   KIN_WRITELN(_g_fd, _g_out)
;   KIN_CLOSE_FILE(_g_fd)
;
; REVISION HISTORY:
;   2024-01-01  Initial version
; ============================================================================

; ---------------------------------------------------------------------------
; KIN_OPEN_FILE
; Opens (creates/truncates) the report file and returns the file descriptor.
; Caller must check return value: negative value means error.
; Parameters:
;   sPath  [STRING[120]]  Full path to output file
; Returns:   INT  file descriptor (>= 0) or error code (< 0)
; ---------------------------------------------------------------------------
PROC KIN_OPEN_FILE(STRING[120] sPath) SAVE
DEF INT _fd
_fd = FILEOPEN(sPath, "w")
RET(_fd)

; ---------------------------------------------------------------------------
; KIN_CLOSE_FILE
; Closes a previously opened file.
; Parameters:
;   ifd  [INT]  file descriptor returned by KIN_OPEN_FILE
; ---------------------------------------------------------------------------
PROC KIN_CLOSE_FILE(INT ifd) SAVE
FILECLOSE(ifd)
RET

; ---------------------------------------------------------------------------
; KIN_WRITELN
; Writes a single line (string) to the open file.
; Parameters:
;   ifd   [INT]        file descriptor
;   sLine [STRING[120]] text to write
; ---------------------------------------------------------------------------
PROC KIN_WRITELN(INT ifd, STRING[120] sLine) SAVE
FILEWRITE(ifd, sLine)
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_HEADER
; Writes a standardised header block identifying the report.
; Parameters:
;   ifd    [INT]        file descriptor
;   sTitle [STRING[60]] section title (e.g. "TRAORI 5-AXIS")
; ---------------------------------------------------------------------------
PROC KIN_WRITE_HEADER(INT ifd, STRING[60] sTitle) SAVE
DEF STRING[120] sSep
sSep = "============================================================"
FILEWRITE(ifd, sSep)
FILEWRITE(ifd, "  SINUMERIK KINEMATICS REPORT")
FILEWRITE(ifd, "  Section: " << sTitle)
FILEWRITE(ifd, "  Generated by: " << $P_PROG)
FILEWRITE(ifd, sSep)
FILEWRITE(ifd, "")
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_SECTION
; Writes a sub-section heading.
; Parameters:
;   ifd    [INT]        file descriptor
;   sTitle [STRING[60]] sub-section title
; ---------------------------------------------------------------------------
PROC KIN_WRITE_SECTION(INT ifd, STRING[60] sTitle) SAVE
FILEWRITE(ifd, "")
FILEWRITE(ifd, "--- " << sTitle << " ---")
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_REAL
; Writes a labelled real value with physical unit.
; Parameters:
;   ifd    [INT]        file descriptor
;   sLabel [STRING[60]] human-readable label
;   rVal   [REAL]       value to write
;   sUnit  [STRING[10]] unit string (e.g. "mm", "deg", "-")
; ---------------------------------------------------------------------------
PROC KIN_WRITE_REAL(INT ifd, STRING[60] sLabel, REAL rVal, STRING[10] sUnit) SAVE
DEF STRING[120] sLine
sLine = "  " << sLabel << " = " << TOSTRING(rVal) << " [" << sUnit << "]"
FILEWRITE(ifd, sLine)
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_INT
; Writes a labelled integer value.
; Parameters:
;   ifd    [INT]        file descriptor
;   sLabel [STRING[60]] human-readable label
;   iVal   [INT]        value to write
; ---------------------------------------------------------------------------
PROC KIN_WRITE_INT(INT ifd, STRING[60] sLabel, INT iVal) SAVE
DEF STRING[120] sLine
sLine = "  " << sLabel << " = " << TOSTRING(iVal)
FILEWRITE(ifd, sLine)
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_VEC3
; Writes a labelled 3-component vector (X, Y, Z).
; Parameters:
;   ifd    [INT]        file descriptor
;   sLabel [STRING[60]] human-readable label
;   rX     [REAL]       X component
;   rY     [REAL]       Y component
;   rZ     [REAL]       Z component
;   sUnit  [STRING[10]] unit string
; ---------------------------------------------------------------------------
PROC KIN_WRITE_VEC3(INT ifd, STRING[60] sLabel, REAL rX, REAL rY, REAL rZ, STRING[10] sUnit) SAVE
DEF STRING[120] sLine
sLine = "  " << sLabel << " = [" << TOSTRING(rX) << ", " << TOSTRING(rY) << ", " << TOSTRING(rZ) << "] [" << sUnit << "]"
FILEWRITE(ifd, sLine)
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_BOOL
; Writes a labelled boolean flag as "TRUE" / "FALSE".
; Parameters:
;   ifd    [INT]        file descriptor
;   sLabel [STRING[60]] human-readable label
;   bVal   [BOOL]       value
; ---------------------------------------------------------------------------
PROC KIN_WRITE_BOOL(INT ifd, STRING[60] sLabel, BOOL bVal) SAVE
DEF STRING[120] sLine
IF bVal == TRUE
  sLine = "  " << sLabel << " = TRUE"
ELSE
  sLine = "  " << sLabel << " = FALSE"
ENDIF
FILEWRITE(ifd, sLine)
RET

; ---------------------------------------------------------------------------
; KIN_WRITE_STR
; Writes a labelled string value.
; Parameters:
;   ifd    [INT]        file descriptor
;   sLabel [STRING[60]] human-readable label
;   sVal   [STRING[60]] value string
; ---------------------------------------------------------------------------
PROC KIN_WRITE_STR(INT ifd, STRING[60] sLabel, STRING[60] sVal) SAVE
DEF STRING[120] sLine
sLine = "  " << sLabel << " = " << sVal
FILEWRITE(ifd, sLine)
RET

; ============================================================================
; End of _KIN_WRITE_UTILS.SPF
; ============================================================================
